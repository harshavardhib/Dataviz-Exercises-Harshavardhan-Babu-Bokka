        "# Task 1\n",
        "# YOUR CODE HERE\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "# 1. Clean the price column and convert it to numbers\n",
        "df['price'] = (\n",
        "    df['price']\n",
        "    .astype(str)\n",
        "    .str.replace(r'[^0-9.]', '', regex=True)\n",
        ")\n",
        "\n",
        "df['price'] = pd.to_numeric(df['price'], errors='coerce')\n",
        "\n",
        "# 2. Remove missing and invalid prices\n",
        "df = df[df['price'].notna() & (df['price'] > 0)].copy()\n",
        "\n",
        "# 3. Calculate the 95th percentile and cap extreme prices\n",
        "p95 = df['price'].quantile(0.95)\n",
        "df_cap = df[df['price'] <= p95].copy()\n",
        "\n",
        "print(f\"95th percentile price: {p95:.2f}\")\n",
        "print(df_cap.groupby('room_type')['price'].describe().round(1))\n",
        "\n",
        "# 4. Select the two room types\n",
        "room_types = ['Entire home/apt', 'Private room']\n",
        "plot_df = df_cap[df_cap['room_type'].isin(room_types)]\n",
        "\n",
        "# 5. Draw overlapping histograms\n",
        "plt.figure(figsize=(10, 6))\n",
        "\n",
        "sns.histplot(\n",
        "    data=plot_df,\n",
        "    x='price',\n",
        "    hue='room_type',\n",
        "    bins=40,\n",
        "    element='step',\n",
        "    stat='density',\n",
        "    common_norm=False,\n",
        "    alpha=0.3\n",
        ")\n",
        "\n",
        "# 6. Add a median line for each room type\n",
        "for room in room_types:\n",
        "    median_price = plot_df.loc[\n",
        "        plot_df['room_type'] == room, 'price'\n",
        "    ].median()\n",
        "\n",
        "    plt.axvline(\n",
        "        median_price,\n",
        "        linestyle='--',\n",
        "        linewidth=2,\n",
        "        label=f'{room} median: {median_price:.0f}'\n",
        "    )\n",
        "\n",
        "plt.title('Entire Homes Cost More Than Private Rooms')\n",
        "plt.xlabel('Price per Night')\n",
        "plt.ylabel('Density')\n",
        "plt.xlim(0, p95)\n",
        "plt.legend()\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ]
    },
